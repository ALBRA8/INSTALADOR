generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ALBRA PLATFORM — LOCAL REGISTRY & PLATFORM STATE
// ─────────────────────────────────────────────────────────────

model InstalledProduct {
  id            String    @id @default(cuid())
  productId     String    @unique
  displayName   String
  vendor        String
  version       String
  channel       String    @default("stable")
  state         String    @default("INSTALLED") // LifecycleState
  health        String    @default("UNKNOWN") // HealthStatus
  port          Int?
  runtimeHandle String?
  installPath   String?
  dataPath      String?
  packageHash   String?
  entitlement   String?
  installedAt   DateTime?
  startedAt     DateTime?
  stoppedAt     DateTime?
  lastHealthAt  DateTime?
  // V2 REAL RUNTIME: evidencia de proceso real del sistema operativo
  pid             Int?      // PID real del proceso del producto
  bootToken       String?   // token de instancia para endpoint /health autenticado
  lastExitEvidence String?  // JSON: evidencia de la última salida (graceful/crash + tail de err.log)
  originType      String?   // vault | github
  originRepo      String?   // owner/repo si originType=github
  originRef       String?   // tag/release/commit fijado (NUNCA rama)
  originCommit    String?   // sha resuelto
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  containerDeployment ContainerDeployment?
}

model InstallModuleProgress {
  id         String    @id @default(cuid())
  runId      String
  moduleKey  String
  moduleType String // PROJECT | DEPENDENCY | RUNTIME | SOURCE
  label      String
  status     String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED | SKIPPED
  percent    Int       @default(0)
  detail     String?
  order      Int       @default(0)
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([runId])
  @@unique([runId, moduleKey])
}

model LicenseValidation {
  id          String    @id @default(cuid())
  runId       String?
  packageId   String
  keyHash     String
  keyLast4    String
  outcome     String // VALIDATED | REJECTED
  reasonCode  String?
  licensee    String?
  plan        String?
  apiEndpoint String
  durationMs  Int?
  detail      Json?
  createdAt   DateTime  @default(now())

  @@index([packageId, createdAt])
}

model ContainerDeployment {
  id                 String   @id @default(cuid())
  productId          String   @unique
  projectName        String   @unique
  installPath        String
  composeFile        String
  envFile            String
  networkName        String   @default("albra-agents")
  imageDigests       Json
  desiredState       String   @default("STOPPED") // RUNNING | STOPPED
  observedState      String   @default("UNKNOWN") // RUNNING | STOPPED | DEGRADED | UNKNOWN
  health             String   @default("UNKNOWN") // HEALTHY | DEGRADED | FAILED | UNKNOWN
  lastObservedAt     DateTime?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product InstalledProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)
}

model PackageArtifact {
  id          String   @id @default(cuid())
  packageId   String
  version     String
  channel     String   @default("stable")
  fileName    String
  sha256      String
  signature   String
  verified    Boolean  @default(false)
  manifest    Json
  // V2 TRUST CHAIN: autenticidad (no solo integridad)
  signerKeyId String?  // id de la clave que firmó
  signatureAlg String? // hmac-dev | ed25519
  trustLevel  String?  // DEV_LOCAL | TRUSTED | NONE
  originType  String?  // vault | github
  originRepo  String?  // owner/repo si fue importado de GitHub
  originRef   String?  // tag/release/commit fijado
  originCommit String? // sha resuelto
  createdAt   DateTime @default(now())

  @@unique([packageId, version])
}

model LifecycleRun {
  id         String    @id @default(cuid())
  productId  String?
  operation  String // INSTALL | START | STOP | RESTART | UPDATE | ROLLBACK | REPAIR | BACKUP | RESTORE | UNINSTALL | CERTIFICATION | CLEANROOM
  status     String    @default("RUNNING") // RUNNING | SUCCESS | WARNING | FAILURE | ROLLED_BACK
  steps      Json
  result     Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// Durable anti-replay registry for authenticated EEC operations.
model EecNonce {
  nonce     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String // INSTALL_STARTED, INSTALL_COMPLETED, ...
  productId String?
  actor     String   @default("platform")
  severity  String   @default("INFO") // INFO | WARN | ERROR
  detail    Json?
  createdAt DateTime @default(now())
}

model LogEntry {
  id        String   @id @default(cuid())
  level     String   @default("info") // debug | info | warn | error
  channel   String   @default("SYSTEM") // USER | SYSTEM | DEBUG | AUDIT
  productId String?
  message   String
  data      Json?
  createdAt DateTime @default(now())
}

model HealthSnapshot {
  id        String   @id @default(cuid())
  productId String
  overall   String // HEALTHY | DEGRADED | FAILED | UNKNOWN
  checks    Json
  createdAt DateTime @default(now())
}

model BackupRecord {
  id        String   @id @default(cuid())
  productId String
  kind      String // PRE_UPDATE | MANUAL | PRE_UNINSTALL
  version   String
  note      String?
  sizeBytes Int      @default(0)
  payload   Json?
  filePath  String?
  createdAt DateTime @default(now())
}

model DiagnosticBundleRec {
  id        String   @id @default(cuid())
  productId String
  summary   Json
  findings  Json
  createdAt DateTime @default(now())
}

model SecretRecord {
  id        String   @id @default(cuid())
  key       String
  productId String?
  cipher    String
  hint      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, productId])
}

model ConfigRecord {
  id        String   @id @default(cuid())
  productId String
  scope     String // USER | SYSTEM | PRODUCT
  values    Json
  updatedAt DateTime @updatedAt

  @@unique([productId, scope])
}

model ProviderRecord {
  id         String   @id @default(cuid())
  providerId String
  productId  String?
  status     String   @default("DISCOVERED") // ProviderStatus
  meta       Json?
  updatedAt  DateTime @updatedAt

  @@unique([providerId, productId])
}

model PlatformState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// PILOT PRODUCTS — ISOLATED PRODUCT DATA (per-product tables)
// ─────────────────────────────────────────────────────────────

model CrmContact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmDeal {
  id        String   @id @default(cuid())
  title     String
  contactId String?
  value     Float    @default(0)
  stage     String   @default("NUEVO") // NUEVO | CONTACTADO | PROPUESTA | GANADO | PERDIDO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadRecord {
  id        String   @id @default(cuid())
  name      String
  company   String?
  source    String   @default("WEB")
  status    String   @default("NUEVO") // NUEVO | CALIFICADO | CONTACTADO | DESCARTADO
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
